{
  "name": "beach-sports-ds",
  "version": "0.0.0",
  "private": true,
  "description": "Beach Sports DS \u2014 design system monorepo (tokens + React components)",
  "license": "MIT",
  "author": "Thay Santos",
  "homepage": "https://thaydds.github.io/Beach-Sports-DS/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaydds/Beach-Sports-DS.git"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "build:tokens": "nx run tokens:build",
    "build:components": "nx run components:build",
    "storybook": "nx run components:storybook",
    "build:storybook": "nx run components:build-storybook",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "affected": "nx affected -t lint,typecheck,test,build,build-storybook,test-browser",
    "prepare": "husky",
    "lint:styles": "nx run components:lint-styles",
    "test:browser": "nx run components:test-browser",
    "test:release": "nx run release-automation:test",
    "release:preview": "node tools/release/prepare.mjs --dry-run",
    "tokens:audit": "node tools/figma-audit/compare.mjs",
    "test:figma-audit": "node --test tools/figma-audit/*.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@nx/eslint": "21.6.11",
    "@nx/eslint-plugin": "21.6.11",
    "@nx/js": "21.6.11",
    "@nx/storybook": "21.6.11",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "9.1.21",
    "@storybook/addon-docs": "9.1.21",
    "@storybook/react-vite": "9.1.21",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "nx": "21.6.11",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "release-please": "17.11.2",
    "storybook": "9.1.21",
    "style-dictionary": "5.7.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "vitest-axe": "0.1.0",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
