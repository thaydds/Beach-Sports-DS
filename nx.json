{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/storybook-static/**/*",
      "!{projectRoot}/node_modules/**/*",
      "!{projectRoot}/**/*.tsbuildinfo",
      "!{projectRoot}/docs/Tokens.mdx",
      "sharedGlobals",
      "!{projectRoot}/test-results/**/*",
      "!{projectRoot}/playwright-report/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.{ts,tsx}",
      "!{projectRoot}/**/*.spec.{ts,tsx}",
      "!{projectRoot}/**/*.stories.{ts,tsx}",
      "!{projectRoot}/**/*.mdx",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/storybook-static/**/*",
      "!{projectRoot}/e2e/**/*",
      "!{projectRoot}/playwright.config.ts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/stylelint.config.mjs",
      "{workspaceRoot}/.prettierrc.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{projectRoot}/storybook-static"]
    }
  },
  "release": {
    "projects": ["tokens", "components"],
    "version": {
      "conventionalCommits": true,
      "preMajor": true,
      "updateDependents": "never",
      "preserveLocalDependencyProtocols": true,
      "preserveMatchingDependencyRanges": true
    },
    "changelog": {
      "projectChangelogs": true,
      "workspaceChangelog": false
    },
    "projectsRelationship": "independent",
    "releaseTagPattern": "{projectName}@{version}",
    "git": {
      "commit": false,
      "tag": false,
      "push": false,
      "stageChanges": false
    }
  }
}
