{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tokens",
  "projectType": "library",
  "sourceRoot": "packages/tokens/src",
  "tags": ["scope:tokens", "type:tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node build.ts && tsc -p tsconfig.lib.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      },
      "inputs": ["default", "^production", "{workspaceRoot}/docs/tokens.md"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "packages/tokens"
      }
    }
  }
}
