      "font-family": { "$type": "string", "$value": "{type.family.primary}" },
      "font-style": { "$type": "string", "$value": "{type.font-style.semi-bold}" },
      "font-weight": { "$type": "number", "$value": 600 },
      "font-size": { "$type": "dimension", "$value": "16px" },
