{
  "name": "figma-align",
  "projectType": "library",
  "sourceRoot": "tools/figma-align",
  "tags": ["type:tooling"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["tools/figma-align/**/*.mjs", "tools/figma-align/plugin/runtime.js"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "inputs": [
        "default",
        "{workspaceRoot}/tools/figma-audit/**/*",
        "{workspaceRoot}/packages/tokens/src/**/*.json",
        "{workspaceRoot}/design/figma/published-token-values.json"
      ],
      "options": { "command": "node --test tools/figma-align/*.test.mjs" }
    }
  }
}
